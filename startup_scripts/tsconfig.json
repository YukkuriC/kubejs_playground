{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@package/*": [
                "../.probe/@package/*"
            ],
            "@side-only/*": [
                "../.probe/@side-only/*"
            ],
            "@special/*": [
                "../.probe/@special/*"
            ]
        },
        "allowJs": true,
        "checkJs": false,
        "lib": [
            "ES5",
            "ES2015"
        ],
        "module": "ES2015",
        "moduleResolution": "node",
        "noEmit": true,
        "target": "ES2015"
    },
    "include": [
        "**/*.js",
        "**/*.d.ts",
        "../.probe/@side-only/startup",
        "../.probe/@special",
        "../.probe/@package",
        "../global.d.ts"
    ]
}
